# 복사해서 .env를 만든 뒤 값을 채우세요: cp .env.example .env
# .env는 git에 올리지 마세요. (.gitignore에 포함되어 있습니다)

# DB 접속정보 (모두 필수)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# 외부 PostgreSQL을 쓸 때는 false로 지정합니다.
# true(기본값)면 db/pgdata에 프로젝트 전용 DB를 만들어 앱과 함께 켜고 끕니다.
# PG_MANAGED=true

# HTTPS로 서비스할 때는 true로 지정합니다. 로그인 쿠키에 Secure 속성을 붙입니다.
# COOKIE_SECURE=false

# docker compose로 실행할 때 웹 포트입니다. (기본값 8090)
# DOCKER_WEB_PORT=8090
